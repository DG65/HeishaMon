{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "DocsPanel",
            "caption": "📖  Documentation & help",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Variables are created automatically as soon as HeishaMon publishes the corresponding topics."
                },
                {
                    "type": "Label",
                    "caption": "Deactivated datapoints are hidden - object ID and archive data remain. New topics are only created while activated. Reorder rows by drag & drop - variables and links follow the order."
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "MQTTTopic",
                    "caption": "MQTT base topic"
                },
                {
                    "type": "PopupButton",
                    "caption": "?",
                    "width": "70px",
                    "popup": {
                        "caption": "MQTT base topic",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Must match the base topic configured in HeishaMon's own web interface exactly. If it does not match, no data is received - without any error message here."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "DebugUnknownTopics",
            "caption": "Debug: unknown topics"
        },
        {
            "type": "List",
            "name": "VariableList",
            "caption": "Datapoints",
            "rowCount": 15,
            "add": false,
            "delete": false,
            "changeOrder": true,
            "loadValuesFromConfiguration": false,
            "columns": [
                {
                    "caption": "Active",
                    "name": "Selected",
                    "width": "80px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Caption",
                    "width": "auto",
                    "add": ""
                },
                {
                    "caption": "Group",
                    "name": "Group",
                    "width": "170px",
                    "add": ""
                },
                {
                    "caption": "Topic",
                    "name": "Topic",
                    "width": "320px",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "Received",
                    "name": "Received",
                    "width": "110px",
                    "add": ""
                }
            ],
            "values": []
        },
        {
            "type": "ExpansionPanel",
            "caption": "Link structure (optional)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Creates a grouped category tree (Operation, Heating, DHW, ...) with links to all active datapoints in the target category selected below - visible in the management console's object tree, not in WebFront. Without a selected target category, nothing is created. Links of deactivated datapoints are removed automatically."
                },
                {
                    "type": "CheckBox",
                    "name": "CreateLinks",
                    "caption": "Create link structure"
                },
                {
                    "type": "SelectCategory",
                    "name": "LinksLocation",
                    "caption": "Target category (required for the link structure to be created)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "External energy meter (optional, for measured COP / performance factor)",
            "items": [
                {
                    "type": "Label",
                    "caption": "If an external energy meter (e.g. Shelly 3EM) measures the heat pump supply line, select its variables here. The module then calculates the measured COP and the daily performance factor from the meter readings."
                },
                {
                    "type": "SelectVariable",
                    "name": "PowerVariable",
                    "caption": "Energy meter: active power of the heat pump (W)"
                },
                {
                    "type": "SelectVariable",
                    "name": "EnergyVariable",
                    "caption": "Energy meter: energy counter of the heat pump (kWh)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "COPMinPower",
                            "caption": "Minimum power for COP calculation",
                            "suffix": " W"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Minimum power for COP calculation",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "Below this power, COP (measured) reports 0 instead of a misleading ratio - protects against standby noise (typically a few watts)."
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update variable names",
            "confirm": "Renames variables that still carry an old default name to the current translation. Custom names remain untouched.",
            "onClick": "HEISHA_UpdateVariableNames($id);"
        },
        {
            "type": "Button",
            "caption": "Reset order and selection",
            "confirm": "Really reset the datapoint list to its default order and selection?",
            "onClick": "HEISHA_ResetVariableList($id);"
        },
        {
            "type": "TestCenter"
        }
    ],
    "status": []
}
